{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "ETL Shadow Test: JVM and DuckDB",
  "uid": "etl-shadow-test",
  "tags": [
    "etl-shadow-test"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_cpu_usage{application=\"etl-shadow-test\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      },
      {
        "name": "namespace",
        "label": "Kubernetes namespace",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Test Run DuckDB instances (running Test Runs)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(duckdb_instances{application=\"etl-shadow-test\", instance=~\"$instance\", role=\"test-run\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Process CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(process_cpu_usage{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"etl-shadow-test\", instance=~\"$instance\", area=\"heap\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DuckDB memory used (all roles)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(duckdb_memory_used_bytes{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        }
      ]
    },
    {
      "type": "row",
      "title": "CPU",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU by part (cores)",
      "description": "test-runs: Test Run threads, including DuckDB work on the calling thread. native: DuckDB worker threads plus JVM GC/JIT. other-java: HTTP, heartbeats, sweeps, webhooks.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{part}}",
          "expr": "sum by (part) (rate(shadow_process_cpu_time_seconds_total{application=\"etl-shadow-test\", instance=~\"$instance\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process CPU vs. available cores",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "process (cores)",
          "expr": "sum(process_cpu_usage{application=\"etl-shadow-test\", instance=~\"$instance\"} * system_cpu_count{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        },
        {
          "refId": "B",
          "legendFormat": "available cores",
          "expr": "sum(system_cpu_count{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        },
        {
          "refId": "C",
          "legendFormat": "GC pause (s/s)",
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"etl-shadow-test\", instance=~\"$instance\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Memory",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Process memory: JVM heap + non-heap + DuckDB",
      "description": "Stacked: what the service accounts for. Compare with the container's working set and limit (from cAdvisor/kube-state-metrics) to see the unaccounted rest (thread stacks, direct buffers, native libraries).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "JVM heap",
          "expr": "sum(jvm_memory_used_bytes{application=\"etl-shadow-test\", instance=~\"$instance\", area=\"heap\"})"
        },
        {
          "refId": "B",
          "legendFormat": "JVM non-heap",
          "expr": "sum(jvm_memory_used_bytes{application=\"etl-shadow-test\", instance=~\"$instance\", area=\"nonheap\"})"
        },
        {
          "refId": "C",
          "legendFormat": "DuckDB {{role}}",
          "expr": "sum by (role) (duckdb_memory_used_bytes{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        },
        {
          "refId": "D",
          "legendFormat": "container working set",
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"etl-shadow-test.*\", container!=\"\", container!=\"POD\"})"
        },
        {
          "refId": "E",
          "legendFormat": "container limit",
          "expr": "sum(kube_pod_container_resource_limits{namespace=~\"$namespace\", pod=~\"etl-shadow-test.*\", resource=\"memory\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap: used / committed / max",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "used",
          "expr": "sum(jvm_memory_used_bytes{application=\"etl-shadow-test\", instance=~\"$instance\", area=\"heap\"})"
        },
        {
          "refId": "B",
          "legendFormat": "committed",
          "expr": "sum(jvm_memory_committed_bytes{application=\"etl-shadow-test\", instance=~\"$instance\", area=\"heap\"})"
        },
        {
          "refId": "C",
          "legendFormat": "max",
          "expr": "sum(jvm_memory_max_bytes{application=\"etl-shadow-test\", instance=~\"$instance\", area=\"heap\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DuckDB memory used vs. memory_limit, by role",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "used {{role}}",
          "expr": "sum by (role) (duckdb_memory_used_bytes{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        },
        {
          "refId": "B",
          "legendFormat": "limit {{role}}",
          "expr": "sum by (role) (duckdb_memory_limit_bytes{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DuckDB spilled to temp-directory",
      "description": "Bytes on disk under shadow.duckdb.temp-directory. Growth means a Row Diff did not fit in memory_limit (allowed, but slower).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{role}}",
          "expr": "sum by (role) (duckdb_temporary_storage_bytes{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM threads and GC",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "live threads",
          "expr": "sum(jvm_threads_live_threads{application=\"etl-shadow-test\", instance=~\"$instance\"})"
        },
        {
          "refId": "B",
          "legendFormat": "GC pauses / s",
          "expr": "sum(rate(jvm_gc_pause_seconds_count{application=\"etl-shadow-test\", instance=~\"$instance\"}[$__rate_interval]))"
        }
      ]
    }
  ]
}
